{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "before 7am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Maven coordinates declared in Amper module dependency lists.",
      "managerFilePatterns": [
        "/(^|/)module\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)(?<indentation>\\s*)-\\s+(?<packageName>[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+):(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "maven",
      "versioningTemplate": "gradle"
    },
    {
      "customType": "regex",
      "description": "Update Maven coordinates declared in Amper annotation processors.",
      "managerFilePatterns": [
        "/(^|/)module\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)(?<indentation>\\s*)dependency:\\s+(?<packageName>[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+):(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "maven",
      "versioningTemplate": "gradle"
    },
    {
      "customType": "regex",
      "description": "Update the repo-owned generated Android Gradle distribution version.",
      "managerFilePatterns": [
        "/^scripts/ci/lib/android_generated_gradle\\.sh$/"
      ],
      "matchStrings": [
        "android_generated_gradle_version=\"\\$\\{ANDROID_GENERATED_GRADLE_VERSION:-(?<currentValue>[^}]+)\\}\""
      ],
      "depNameTemplate": "gradle",
      "datasourceTemplate": "gradle-version",
      "versioningTemplate": "gradle"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "groupName": "ruby tooling"
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "groupName": "gradle and kotlin catalog"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "maven"
      ],
      "matchFileNames": [
        "**/module.yaml"
      ],
      "groupName": "amper maven dependencies",
      "registryUrls": [
        "https://dl.google.com/android/maven2/",
        "https://repo.maven.apache.org/maven2",
        "https://plugins.gradle.org/m2/"
      ]
    },
    {
      "description": "Keep Metro runtime, compiler, and Gradle bridge plugin versions synchronized.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^dev\\.zacsweers\\.metro:/"
      ],
      "groupName": "metro shared kotlin toolchain",
      "groupSlug": "metro-shared-kotlin-toolchain",
      "minimumGroupSize": 2
    },
    {
      "description": "Hold Metro below the Kotlin 2.4 Native ABI line while the Gradle bridge still uses SKIE with Kotlin 2.3.x.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^dev\\.zacsweers\\.metro:/"
      ],
      "allowedVersions": "<1.2.0"
    },
    {
      "description": "Hold the Gradle bridge Kotlin compiler below 2.4 until SKIE supports Kotlin 2.4.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin\\./",
        "/^org\\.jetbrains\\.kotlin:/"
      ],
      "allowedVersions": "<2.4.0"
    },
    {
      "description": "Keep Kotlin coroutines versions synchronized between Amper modules and the Gradle bridge catalog.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlinx:kotlinx-coroutines-/"
      ],
      "groupName": "kotlin coroutines shared toolchain",
      "groupSlug": "kotlin-coroutines-shared-toolchain",
      "minimumGroupSize": 2
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
