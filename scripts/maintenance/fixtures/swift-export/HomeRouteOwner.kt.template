package studio.mekate.mobi.routeprobe

import androidx.compose.runtime.Composable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.remember
import androidx.compose.runtime.rememberCoroutineScope
import androidx.compose.runtime.setValue
import androidx.compose.ui.window.ComposeUIViewController
import kotlinx.atomicfu.atomic
import kotlinx.coroutines.*
import kotlin.coroutines.cancellation.CancellationException
import studio.mekate.mobi.core.CounterRepository
import studio.mekate.mobi.feature.home.CounterLoadable
import studio.mekate.mobi.feature.home.HomeFeatureService
import studio.mekate.mobi.feature.home.HomeFeatureState
import studio.mekate.mobi.feature.home.currentValueForRefresh
import studio.mekate.mobi.ui.home.HomeContent

// Isolated candidate over the actual Compose owner. Limits are explicit diagnostic
// settings. A reservation exists before coroutine construction, registration or launch.
class HomeRouteOwner(private val service: HomeFeatureService, private val maxJobs: Int) {
    init { require(maxJobs > 0) }
    private class Reservation { val job = atomic<Job?>(null) }
    private data class Ownership(val retired: Boolean, val reservations: List<Reservation>)
    private val ownership = atomic(Ownership(false, emptyList()))
    private val accepted = atomic(0)
    private val rejected = atomic(0)
    private val delivered = atomic(0)
    private val cancelled = atomic(0)
    private val finished = atomic(0)
    private val retireTransitions = atomic(0)
    private val lateResultsRejected = atomic(0)
    private val publications = atomic(0)
    private val releases = atomic(0)
    private val maximum = atomic(0)
    private val probeAttempts = atomic(0)
    private val retireBeforeAttach = atomic(false)
    private val probeScope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)

    val isOpen: Boolean get() = !ownership.value.retired
    val isDrained: Boolean get() = ownership.value.let { it.retired && it.reservations.isEmpty() }
    fun usesService(other: HomeFeatureService): Boolean = service === other
    fun createViewController() = ComposeUIViewController { OwnedHomeScreen(this, service) }
    fun retire() {
        while (true) {
            val prior = ownership.value
            if (prior.retired) return
            if (ownership.compareAndSet(prior, prior.copy(retired = true))) {
                retireTransitions.incrementAndGet()
                prior.reservations.forEach { it.job.value?.cancel(CancellationException("Home route retired")) }
                probeScope.cancel()
                return
            }
        }
    }
    private fun reserve(): Reservation? {
        while (true) {
            val prior = ownership.value
            if (prior.retired || prior.reservations.size >= maxJobs) { rejected.incrementAndGet();return null }
            val token = Reservation()
            val next = prior.copy(reservations = prior.reservations + token)
            if (ownership.compareAndSet(prior, next)) {
                accepted.incrementAndGet()
                while (true) { val m = maximum.value;if (m >= next.reservations.size || maximum.compareAndSet(m, next.reservations.size)) break }
                return token
            }
        }
    }
    private fun forget(token: Reservation) {
        while (true) {
            val prior = ownership.value
            if (prior.reservations.none { it === token }) return
            if (ownership.compareAndSet(prior, prior.copy(reservations = prior.reservations.filterNot { it === token }))) {
                releases.incrementAndGet();return
            }
        }
    }
    private fun tryLaunch(scope: CoroutineScope, value: Int, loading: () -> Unit, publish: (HomeFeatureState) -> Unit): Boolean {
        val token = reserve() ?: return false
        var created: Job? = null
        try {
            if (retireBeforeAttach.getAndSet(false)) retire()
            val job = scope.launch(start = CoroutineStart.LAZY) {
                try {
                    currentCoroutineContext().ensureActive()
                    val result = service.refresh(value)
                    if (!isOpen || !currentCoroutineContext().isActive) {
                        lateResultsRejected.incrementAndGet();throw CancellationException("Retired result")
                    }
                    delivered.incrementAndGet();publish(result);publications.incrementAndGet()
                } catch (error: CancellationException) { cancelled.incrementAndGet();throw error }
                finally { finished.incrementAndGet() }
            }
            created = job
            // Install actual-completion cleanup before attaching/starting. Retire can
            // win either side of attachment; both paths keep the reservation until Job completion.
            job.invokeOnCompletion { forget(token) }
            token.job.value = job
            if (!isOpen) job.cancel(CancellationException("Retired before attach"))
            if (job.isActive || !job.isCancelled) { loading();job.start() }
            return true
        } catch (error: Throwable) {
            val job = created
            if (job == null) forget(token)
            else { job.invokeOnCompletion { forget(token) };job.cancel() }
            throw error
        }
    }
    // These controls call the exact entry used by the Compose callback. The UI and
    // diagnostic command scope differ; no gesture/general global-job guarantee is claimed.
    fun startProbe(value: Int): Boolean = tryLaunch(probeScope, value, {}, {})
    fun burstProbe(count: Int) {
        CoroutineScope(Dispatchers.Default).launch {
            coroutineScope { repeat(count) { launch { startProbe(0);probeAttempts.incrementAndGet() } } }
        }
    }
    fun failLoadingProbe() = runCatching { tryLaunch(probeScope,0,{ error("Injected loading failure") },{}) }.isFailure
    fun armRetireBeforeAttachment() { retireBeforeAttach.value = true }
    fun snapshot() = RouteMetrics(isOpen,isDrained,ownership.value.reservations.size,accepted.value,rejected.value,
        delivered.value,cancelled.value,finished.value,retireTransitions.value,lateResultsRejected.value,
        publications.value,releases.value,maximum.value,probeAttempts.value)

    @Composable private fun OwnedHomeScreen(owner: HomeRouteOwner, sharedService: HomeFeatureService) {
        var state by remember(sharedService) { mutableStateOf(sharedService.initialState()) }
        val scope = rememberCoroutineScope()
        HomeContent(state = state, onEvent = {
            if (owner.isOpen && state.counterLoadable !is CounterLoadable.Loading) {
                val previous = state.counterLoadable.currentValueForRefresh()
                owner.tryLaunch(scope,previous,{ state = sharedService.loadingState(previous) },{ state = it })
            }
        })
    }
}
data class RouteMetrics(val open: Boolean,val drained: Boolean,val activeJobs: Int,val accepted: Int,val rejected: Int,
    val delivered: Int,val cancelled: Int,val finished: Int,val retireTransitions: Int,val lateResultsRejected: Int,
    val publications: Int,val releases: Int,val maximum: Int,val probeAttempts: Int)

// Real HomeFeatureService with an intentionally noncooperative repository gate.
class RouteJobGateSession {
    private val gate = CompletableDeferred<Unit>()
    private val entered = atomic(0)
    private val active = atomic(0)
    private val maximum = atomic(0)
    private val returned = atomic(0)
    val service = HomeFeatureService(object : CounterRepository {
        override suspend fun fetchNextCounterValue(currentCounterValue: Int): Int {
            entered.incrementAndGet();val a = active.incrementAndGet()
            while (true) { val m = maximum.value;if (m >= a || maximum.compareAndSet(m,a)) break }
            try {
                withContext(NonCancellable) { gate.await() }
                returned.incrementAndGet();return currentCounterValue + 1
            } finally { active.decrementAndGet() }
        }
    })
    fun enteredCount() = entered.value
    fun activeCount() = active.value
    fun maximumCount() = maximum.value
    fun returnedCount() = returned.value
    fun releaseGate() { gate.complete(Unit) }
    fun invalidLimitRejected() = runCatching { HomeRouteOwner(service,0) }.isFailure
}
