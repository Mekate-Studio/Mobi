// Version-1 prototype wire algebra. Swift copies these into checked Sendable enums
// synchronously on the main actor; Kotlin wrappers never become async return values.
data class NativeHomeSnapshot(val tag: Int, val value: Int?, val reason: Int?)
data class NativeRequestSnapshot(val phase: Int, val drained: Boolean, val value: NativeHomeSnapshot?)
data class FacadeMetrics(val retired: Boolean, val active: Int, val retained: Int,
    val accepted: Int, val delivered: Int, val cancelled: Int, val lateRejected: Int, val retireTransitions: Int, val initialReads: Int, val loadingReads: Int)

private fun nativeValue(state: HomeFeatureState): NativeHomeSnapshot = when (val loadable = state.counterLoadable) {
    CounterLoadable.Initial -> NativeHomeSnapshot(0, null, null)
    is CounterLoadable.Loading -> NativeHomeSnapshot(1, loadable.previousValue, null)
    is CounterLoadable.Loaded -> NativeHomeSnapshot(2, loadable.value, null)
    is CounterLoadable.Error -> NativeHomeSnapshot(3, loadable.previousValue, when (loadable.reason) {
        CounterLoadFailureReason.RepositoryUnavailable -> 0
        CounterLoadFailureReason.Unexpected -> 1
    })
}

// Deterministic controls use the unchanged shared service's real error/state mapping.
class ScriptedFacadeSession(private val outcome: Int) {
    val service = HomeFeatureService(object : studio.mekate.mobi.core.CounterRepository {
        override suspend fun fetchNextCounterValue(currentCounterValue: Int): Int = when (outcome) {
            0 -> currentCounterValue + 1
            1 -> throw studio.mekate.mobi.core.CounterRepositoryException()
            else -> throw IllegalStateException("Scripted unexpected error")
        }
    })
}

class ControlledHomeSession {
    private var gate = kotlinx.coroutines.CompletableDeferred<Unit>()
    private var noncooperative = false
    private var entered = 0
    private var active = 0
    val service = HomeFeatureService(object : studio.mekate.mobi.core.CounterRepository {
        override suspend fun fetchNextCounterValue(currentCounterValue: Int): Int {
            entered++; active++
            try {
                if (noncooperative) kotlinx.coroutines.withContext(kotlinx.coroutines.NonCancellable) { gate.await() }
                else gate.await()
                return currentCounterValue + 1
            } finally { active-- }
        }
    })
    fun configure(noncooperative: Boolean) { check(NSThread.isMainThread); check(active == 0); this.noncooperative = noncooperative; gate = kotlinx.coroutines.CompletableDeferred() }
    fun releaseGate() { check(NSThread.isMainThread); gate.complete(Unit) }
    fun entered(): Int { check(NSThread.isMainThread); return entered }
    fun active(): Int { check(NSThread.isMainThread); return active }
}
