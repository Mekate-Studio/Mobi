// Isolated transport prototype, not shared feature state or a replacement service.
// Registry access and its jobs are confined to the platform main thread.
// This permits suspended Home operations to overlap; it is NOT a complete-operation mutex.
class LegacyHomeFacade(private val service: HomeFeatureService) {
    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
    private var retired = false
    private var nextId = 1L
    private val requests = mutableMapOf<Long, Request>()
    private var initialReads = 0
    private var loadingReads = 0
    private var accepted = 0
    private var delivered = 0
    private var cancelled = 0
    private var lateRejected = 0
    private var retireTransitions = 0
    private class Request {
        lateinit var job: Job
        var phase = 0 // running, delivered, cancelled, unexpected bridge failure
        var value: NativeHomeSnapshot? = null
    }
    private fun requireMain() { check(NSThread.isMainThread) }
    fun usesService(other: HomeFeatureService): Boolean { requireMain(); return service === other }
    fun initialValue(): NativeHomeSnapshot { requireMain(); initialReads++; return nativeValue(service.initialState()) }
    fun loadingValue(current: Int): NativeHomeSnapshot { requireMain(); loadingReads++; return nativeValue(service.loadingState(current)) }
    fun beginRefresh(current: Int): Long {
        requireMain()
        if (retired) return 0
        val id = nextId++
        val request = Request()
        requests[id] = request
        accepted++
        request.job = scope.launch(start = CoroutineStart.LAZY) {
            try {
                val value = service.refresh(current)
                requireMain()
                if (retired || request.phase != 0 || currentCoroutineContext()[Job]?.isActive != true) {
                    lateRejected++
                    throw CancellationException("Native result cancelled")
                }
                request.value = nativeValue(value)
                request.phase = 1
                delivered++
            } catch (error: CancellationException) {
                if (request.phase == 0) { request.phase = 2; cancelled++ }
            } catch (error: Exception) {
                if (request.phase == 0) request.phase = 3
            }
        }
        request.job.start()
        return id
    }
    fun poll(id: Long): NativeRequestSnapshot {
        requireMain()
        val request = checkNotNull(requests[id])
        return NativeRequestSnapshot(request.phase, request.job.isCompleted, request.value)
    }
    fun cancelRequest(id: Long) {
        requireMain()
        val request = requests[id] ?: return
        // A completed value can still be waiting for Swift to consume it.
        if (request.phase == 0 || request.phase == 1) {
            request.phase = 2
            request.value = null
            cancelled++
        }
        request.job.cancel(CancellationException("Native request cancelled"))
    }
    fun forgetRequest(id: Long): Boolean {
        requireMain()
        val request = requests[id] ?: return true
        if (!request.job.isCompleted) return false
        requests.remove(id)
        return true
    }
    fun retire() {
        requireMain()
        if (retired) return
        retired = true
        retireTransitions++
        requests.keys.toList().forEach { cancelRequest(it) }
        scope.coroutineContext[Job]?.cancel()
    }
    fun metrics(): FacadeMetrics {
        requireMain()
        return FacadeMetrics(retired, requests.values.count { !it.job.isCompleted }, requests.size,
            accepted, delivered, cancelled, lateRejected, retireTransitions, initialReads, loadingReads)
    }
}

