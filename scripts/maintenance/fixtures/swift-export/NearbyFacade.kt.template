package studio.mekate.mobi.nearbyfacadeprobe

import kotlinx.atomicfu.atomic
import kotlinx.coroutines.*
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import platform.Foundation.NSThread
import studio.mekate.mobi.core.*
import studio.mekate.mobi.di.SharedDependencies
import studio.mekate.mobi.feature.nearbyvehiclemap.*

private fun mainOnly() { check(NSThread.isMainThread) }
private fun maximum(target: kotlinx.atomicfu.AtomicInt, value: Int) {
    while (true) { val old = target.value; if (value <= old || target.compareAndSet(old, value)) return }
}
// One shared repository policy per hub, not one mutex per client. Registry always Main.
// Scripted failures/gates decorate the actual Metro repository; normal calls delegate unchanged.
class NearbyHub(val policy: Int) {
    private val graph = SharedDependencies.createDefaultGraph()
    private val delegate = graph.nearbyFleetRepository // resolve once; all owners/requests share this exact instance
    private val mutex = Mutex()
    private val outcome = atomic(0)
    private var gate = CompletableDeferred<Unit>() // only configured when idle
    private val entered = atomic(0)
    private val active = atomic(0)
    private val maxActive = atomic(0)
    private val returned = atomic(0)
    private val repository = object : NearbyFleetRepository {
        override suspend fun fetchNearbyFleetSnapshot(request: NearbyFleetRequest): FleetSnapshot {
            suspend fun operation(): FleetSnapshot {
                if (policy == 0) mainOnly()
                entered.incrementAndGet(); maximum(maxActive, active.incrementAndGet())
                try {
                    when (outcome.value) {
                        1 -> throw NearbyFleetRepositoryException()
                        2 -> throw IllegalStateException("Scripted unexpected failure")
                        3 -> gate.await()
                        4 -> withContext(NonCancellable) { gate.await() }
                    }
                    // Noncooperative diagnostic bypasses delegate's cancellable delay intentionally.
                    val snapshot = if (outcome.value == 4) FleetSnapshot(999, request.riderLocation, emptyList(), request.requestedAtMillis)
                        else delegate.fetchNearbyFleetSnapshot(request)
                    if (policy == 0) mainOnly()
                    returned.incrementAndGet()
                    return snapshot
                } finally { active.decrementAndGet() }
            }
            return if (policy == 0) operation() else withContext(Dispatchers.Default) { mutex.withLock { operation() } }
        }
    }
    private val service = NearbyVehicleMapFeatureService(repository, NearbyVehicleMapFreshnessPolicy())
    init { require(policy == 0 || policy == 1) }
    fun makeFacade(): NearbyFacade { mainOnly(); return NearbyFacade(service) }
    fun configure(outcome: Int) { mainOnly(); check(active.value == 0); this.outcome.value = outcome; gate = CompletableDeferred() }
    fun releaseGate() { mainOnly(); gate.complete(Unit) }
    fun metrics(): RepositoryMetrics { mainOnly(); return RepositoryMetrics(entered.value, active.value, maxActive.value, returned.value) }
}
data class RepositoryMetrics(val entered: Int, val active: Int, val maxActive: Int, val returned: Int)

// Immutable states remain original Kotlin values. Handles belong to this facade only.
// Swift additionally verifies an owner UUID before making any raw call.
class NearbyFacade(private val service: NearbyVehicleMapFeatureService) {
    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
    private var retired = false
    private var nextState = 1L
    private var nextRequest = 1L
    private val states = mutableMapOf<Long, NearbyVehicleMapFeatureState>()
    private class Request { lateinit var job: Job; var phase = 0; var value: NearbyVehicleMapFeatureState? = null }
    private val requests = mutableMapOf<Long, Request>()
    private var accepted = 0; private var delivered = 0; private var cancelled = 0; private var lateRejected = 0
    private fun state(id: Long): NearbyVehicleMapFeatureState { mainOnly(); check(!retired); return checkNotNull(states[id]) }
    private fun store(state: NearbyVehicleMapFeatureState): WireState { mainOnly(); check(!retired); val id = nextState++; states[id] = state; return WireState(id, state) }
    fun initialValue(): WireState = store(service.initialState())
    fun available(id: Long, latitude: Double, longitude: Double): WireState = store(service.riderLocationAvailable(state(id), RiderLocation(latitude, longitude)))
    fun blocked(id: Long, reason: Int): WireState = store(service.riderLocationBlocked(state(id), decodeBlocked(reason)))
    fun temporary(id: Long): WireState = store(service.riderLocationTemporarilyUnavailable(state(id)))
    fun loading(id: Long): WireState = store(service.loadingState(state(id)))
    fun timePassed(id: Long, now: Long): WireState = store(service.stateAfterTimePasses(state(id), now))
    fun shouldRefresh(id: Long, now: Long): Boolean = service.shouldRefresh(state(id), now)
    fun hasState(id: Long): Boolean { mainOnly(); return !retired && states.containsKey(id) }
    fun releaseState(id: Long) { mainOnly(); states.remove(id) }
    fun beginRefresh(id: Long, now: Long): Long {
        mainOnly(); if (retired) return 0
        val current = state(id) // immutable captured state survives explicit handle release
        val requestId = nextRequest++; val request = Request(); requests[requestId] = request; accepted++
        request.job = scope.launch(start = CoroutineStart.LAZY) {
            try {
                val result = service.refreshSnapshot(current, now)
                mainOnly()
                if (retired || request.phase != 0 || currentCoroutineContext()[Job]?.isActive != true) {
                    lateRejected++; throw CancellationException("Late Nearby result")
                }
                request.value = result; request.phase = 1; delivered++
            } catch (error: CancellationException) {
                if (request.phase == 0) { request.phase = 2; cancelled++ }
            } catch (error: Exception) { if (request.phase == 0) request.phase = 3 }
        }
        request.job.start(); return requestId
    }
    fun poll(id: Long): WireRequest { mainOnly(); val r = checkNotNull(requests[id]); return WireRequest(r.phase, r.job.isCompleted) }
    fun consume(id: Long): WireState { mainOnly(); val r = checkNotNull(requests[id]); check(r.phase == 1 && r.job.isCompleted && !retired); val result = store(checkNotNull(r.value)); requests.remove(id); return result }
    fun cancelRequest(id: Long) { mainOnly(); val r = requests[id] ?: return; if (r.phase == 0 || r.phase == 1) { r.phase = 2; r.value = null; cancelled++ }; r.job.cancel() }
    fun forgetRequest(id: Long): Boolean { mainOnly(); val r = requests[id] ?: return true; if (!r.job.isCompleted) return false; requests.remove(id); return true }
    fun retire() { mainOnly(); if (retired) return; retired = true; states.clear(); requests.keys.toList().forEach { cancelRequest(it) }; scope.cancel() }
    fun metrics(): FacadeMetrics { mainOnly(); return FacadeMetrics(retired, states.size, requests.size, requests.values.count { !it.job.isCompleted }, accepted, delivered, cancelled, lateRejected) }
}
data class WireRequest(val phase: Int, val drained: Boolean)
data class FacadeMetrics(val retired: Boolean, val states: Int, val requests: Int, val active: Int, val accepted: Int, val delivered: Int, val cancelled: Int, val lateRejected: Int)
data class WireVehicle(val id: String, val latitude: Double, val longitude: Double)
// Wire tags are transport only; the source feature service owns transitions/freshness.
class WireState(val id: Long, private val state: NearbyVehicleMapFeatureState) {
    val schemaVersion = 1
    private val location = (state.riderLocationState as? VisibleRiderLocationState)?.location
    private val snapshot = (state.snapshotState as? SnapshotBackedNearbyVehicleState)?.snapshot
    val locationTag = when(state.riderLocationState) { RiderLocationState.Resolving -> 0; is RiderLocationState.Available -> 1; RiderLocationState.Denied -> 2; is RiderLocationState.Blocked -> 3; is RiderLocationState.TemporarilyUnavailable -> 4; RiderLocationState.Unavailable -> 5 }
    val latitude = location?.latitude
    val longitude = location?.longitude
    val blockedReason = (state.riderLocationState as? RiderLocationState.Blocked)?.reason?.let(::blockedTag)
    val snapshotTag = when(state.snapshotState) { NearbyVehicleSnapshotState.Initial -> 0; NearbyVehicleSnapshotState.Loading -> 1; is NearbyVehicleSnapshotState.Loaded -> 2; is NearbyVehicleSnapshotState.Refreshing -> 3; is NearbyVehicleSnapshotState.FailedWithSnapshot -> 4; is NearbyVehicleSnapshotState.FailedWithoutSnapshot -> 5 }
    val failureReason = (state.snapshotState as? FailedNearbyVehicleSnapshotState)?.reason?.let(::failureTag)
    val sequence = snapshot?.sequence
    val loadedAt = snapshot?.loadedAtMillis
    val snapshotLatitude = snapshot?.riderLocation?.latitude
    val snapshotLongitude = snapshot?.riderLocation?.longitude
    val vehicleCount = snapshot?.vehicles?.size ?: 0
    val overlayTag = when(state.mapOverlayState) { NearbyVehicleMapOverlayState.None -> 0; NearbyVehicleMapOverlayState.RefreshingIndicator -> 1; NearbyVehicleMapOverlayState.StaleIndicator -> 2; NearbyVehicleMapOverlayState.BlockingFailure -> 3 }
    val canRefresh = state.canRequestRefresh()
    val canInteract = state.canInteractWithVehicles()
    fun vehicleAt(index: Int): WireVehicle { val v = checkNotNull(snapshot).vehicles[index]; return WireVehicle(v.id.value, v.location.latitude, v.location.longitude) }
}

private fun blockedTag(reason: RiderLocationBlockedReason): Int = when(reason) {
    RiderLocationBlockedReason.AccessDenied -> 0
    RiderLocationBlockedReason.AccessRestricted -> 1
    RiderLocationBlockedReason.ServicesDisabled -> 2
    RiderLocationBlockedReason.ApproximateOnly -> 3
    RiderLocationBlockedReason.TemporarilyUnavailable -> 4
}
private fun decodeBlocked(tag: Int): RiderLocationBlockedReason = when(tag) {
    0 -> RiderLocationBlockedReason.AccessDenied
    1 -> RiderLocationBlockedReason.AccessRestricted
    2 -> RiderLocationBlockedReason.ServicesDisabled
    3 -> RiderLocationBlockedReason.ApproximateOnly
    4 -> RiderLocationBlockedReason.TemporarilyUnavailable
    else -> error("Invalid blocked tag")
}
private fun failureTag(reason: NearbyVehicleMapFailureReason): Int = when(reason) {
    NearbyVehicleMapFailureReason.RiderLocationUnavailable -> 0
    NearbyVehicleMapFailureReason.RepositoryUnavailable -> 1
    NearbyVehicleMapFailureReason.Unexpected -> 2
}
class WireContractProbe {
    fun legacyBlocked(tag: Int): Int = decodeBlocked(tag).ordinal
    fun stableBlocked(tag: Int): Int = blockedTag(decodeBlocked(tag))
    fun legacyFailure(tag: Int): Int = failure(tag).ordinal
    fun stableFailure(tag: Int): Int = failureTag(failure(tag))
    private fun failure(tag: Int) = when(tag) {
        0 -> NearbyVehicleMapFailureReason.RiderLocationUnavailable
        1 -> NearbyVehicleMapFailureReason.RepositoryUnavailable
        2 -> NearbyVehicleMapFailureReason.Unexpected
        else -> error("Invalid failure tag")
    }
}
