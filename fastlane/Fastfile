# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:android)

def amper_cache_dir
  ENV["AMPER_BOOTSTRAP_CACHE_DIR"] || File.expand_path("../.amper-cache", __dir__)
end

def amper!(command)
  sh("AMPER_BOOTSTRAP_CACHE_DIR='#{amper_cache_dir}' ./amper #{command}")
end

def latest_android_artifact!(pattern: "build/**/*.{apk,aab}")
  candidates = Dir[pattern]
  UI.user_error!("No Android artifact found under build/") if candidates.empty?

  candidates.max_by { |path| File.mtime(path) }
end

platform :android do

  desc "Builds the debug code"
  lane :buildDebug do
    amper!("build -m android-app -p android -v debug")
  end

  desc "Builds the release code"
  lane :buildRelease do
    amper!("build -m android-app -p android -v release")
  end

  desc "Runs all the tests"
  lane :test do
    amper!("test -m shared -p android")
  end

  desc "Submit a new Internal Build to Play Store"
  lane :internal do
    artifact = latest_android_artifact!(pattern: "build/**/*release*.{apk,aab}")

    upload_to_play_store(
      track: 'internal',
      aab: File.extname(artifact) == ".aab" ? artifact : nil,
      apk: File.extname(artifact) == ".apk" ? artifact : nil
    )
  end

  desc "Promote Internal to Alpha"
  lane :promote_internal_to_alpha do
    upload_to_play_store(track: 'internal', track_promote_to: 'alpha')
  end

  desc "Promote Alpha to Beta"
  lane :promote_alpha_to_beta do
    upload_to_play_store(track: 'alpha', track_promote_to: 'beta')
  end

  desc "Promote Beta to Production"
  lane :promote_beta_to_production do
    upload_to_play_store(track: 'beta', track_promote_to: 'production')
  end
end
